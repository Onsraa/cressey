{
  "_comment": "Cressey's hook, for a Claude Code agent. `lab/run_agent.sh --hook` fills CRESSEY_HOOK_URL and CRESSEY_RUN_KEY (a run's own key, from POST /api/runs) into the throwaway copy's .claude/settings.json; don't commit real values. PreToolUse waits for a human up to CRESSEY_HOLD_TIMEOUT (240 s), so its timeout is longer. onFailure block needs Claude Code >= 2.1.295; without it a Cressey that is down lets calls through. SessionStart, UserPromptSubmit and SessionEnd give the dashboard Claude Code's turns (waiting for a prompt, working, ended); they don't block, so a Cressey that is down never swallows a prompt. SessionStart takes no http hook (only command), so a curl posts the same event.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST CRESSEY_HOOK_URL/hook/claude -H 'Authorization: Bearer CRESSEY_RUN_KEY' -H 'Content-Type: application/json' --data-binary @- > /dev/null",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "CRESSEY_HOOK_URL/hook/claude",
            "headers": {
              "Authorization": "Bearer CRESSEY_RUN_KEY"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "CRESSEY_HOOK_URL/hook/claude",
            "headers": {
              "Authorization": "Bearer CRESSEY_RUN_KEY"
            },
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "CRESSEY_HOOK_URL/hook/claude",
            "headers": {
              "Authorization": "Bearer CRESSEY_RUN_KEY"
            },
            "timeout": 300,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "CRESSEY_HOOK_URL/hook/claude",
            "headers": {
              "Authorization": "Bearer CRESSEY_RUN_KEY"
            },
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "CRESSEY_HOOK_URL/hook/claude",
            "headers": {
              "Authorization": "Bearer CRESSEY_RUN_KEY"
            },
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "CRESSEY_HOOK_URL/hook/claude",
            "headers": {
              "Authorization": "Bearer CRESSEY_RUN_KEY"
            },
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "CRESSEY_HOOK_URL/hook/claude",
            "headers": {
              "Authorization": "Bearer CRESSEY_RUN_KEY"
            },
            "timeout": 10
          }
        ]
      }
    ]
  }
}
