# The PocketOS replay lab on real Railway (cressey-pocketos-lab).
# These are opaque Railway UUIDs for a throwaway project, not secrets.
# The tokens are NOT here: they live in the repo's git-ignored .env
# (RAILWAY_LAB_STAGING_TOKEN, RAILWAY_LAB_TRAP_TOKEN, RAILWAY_LAB_PROJECT_ID).

RAILWAY_API=https://backboard.railway.com/graphql/v2

LAB_PROJECT_ID=2ff4bd59-c46d-4b93-82ed-2b9fe32f0e9a
LAB_ENV_STAGING=747e5e0b-dbb3-4e80-909d-c3e50a32a811
LAB_ENV_PRODUCTION=f0d6ed86-9f19-49fa-b8c4-240062c237d9
LAB_SERVICE_POSTGRES=8e98c573-f52d-47b3-9424-ee96e3869bab
LAB_VOLUME_ID=09832b4b-9b1b-423b-a252-662891666e66
LAB_VOLUME_NAME=postgres-volume
LAB_VOLUME_MOUNT=/var/lib/postgresql/data

# Seeded, labelled fake data each environment's DB should hold after a reset.
LAB_SEED_ROWS=5
